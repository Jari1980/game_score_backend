@API_URL=http://localhost:3000/api/v1/match
@token=

### create, admin role required
POST {{API_URL}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "matchDate": "2020-04-20",
  "homeTeam": "Team 3",
  "awayTeam": "Team 4",
  "homeTeamScore": 5,
  "awayTeamScore": 5
}

### get all
GET {{API_URL}}
Authorization: Bearer {{token}}
Content-Type: application/json

### search
@searchTerm=team

GET {{API_URL}}/search?team=Team
Authorization: Bearer {{token}}
Content-Type: application/json
